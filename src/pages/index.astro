---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Strength & Nutrition Calculators" description="1RM, RPE, DOTS, and TDEE calculators">
	<main class="container py-10">
		<h1 class="font-heading mb-8 text-4xl font-bold">Strength & Nutrition Calculators</h1>
		<div class="grid gap-6 lg:grid-cols-2">
			<section class="calc-card">
				<h2>1RM Calculator</h2>
				<label>Weight (kg)<input id="orm-weight" type="number" min="0" step="0.5" /></label>
				<label>Reps<input id="orm-reps" type="number" min="1" max="20" step="1" /></label>
				<p id="orm-result" class="result">Estimated 1RM: —</p>
			</section>

			<section class="calc-card">
				<h2>RPE Calculator</h2>
				<label>Target 1RM (kg)<input id="rpe-orm" type="number" min="0" step="0.5" /></label>
				<label>Reps<input id="rpe-reps" type="number" min="1" max="12" step="1" value="5" /></label>
				<label>RPE<input id="rpe-value" type="number" min="6" max="10" step="0.5" value="8" /></label>
				<p id="rpe-result" class="result">Suggested load: —</p>
			</section>

			<section class="calc-card">
				<h2>DOTS Calculator</h2>
				<label>Sex
					<select id="dots-sex">
						<option value="male">Male</option>
						<option value="female">Female</option>
					</select>
				</label>
				<label>Bodyweight (kg)<input id="dots-bw" type="number" min="30" step="0.1" /></label>
				<label>Total (kg)<input id="dots-total" type="number" min="0" step="0.5" /></label>
				<p id="dots-result" class="result">DOTS score: —</p>
			</section>

			<section class="calc-card">
				<h2>TDEE Calculator</h2>
				<label>Sex
					<select id="tdee-sex"><option value="male">Male</option><option value="female">Female</option></select>
				</label>
				<label>Age<input id="tdee-age" type="number" min="10" max="100" step="1" /></label>
				<label>Weight (kg)<input id="tdee-weight" type="number" min="20" step="0.1" /></label>
				<label>Height (cm)<input id="tdee-height" type="number" min="100" step="1" /></label>
				<label>Activity
					<select id="tdee-activity">
						<option value="1.2">Sedentary</option>
						<option value="1.375">Light</option>
						<option value="1.55" selected>Moderate</option>
						<option value="1.725">Very Active</option>
						<option value="1.9">Athlete</option>
					</select>
				</label>
				<p id="tdee-result" class="result">Estimated TDEE: —</p>
			</section>
		</div>
	</main>

	<script>
		const coeff = {1:1,2:0.955,3:0.922,4:0.892,5:0.863,6:0.837,7:0.811,8:0.786,9:0.762,10:0.739,11:0.707,12:0.68};
		const rpeAdj = {10:0,9.5:0.978,9:0.955,8.5:0.939,8:0.922,7.5:0.907,7:0.892,6.5:0.878,6:0.863};
		
		const bind = (id) => document.getElementById(id);
		const round = (n) => Number.isFinite(n) ? n.toFixed(1) : '—';

		function calc1rm() {
			const w = Number(bind('orm-weight').value); const r = Number(bind('orm-reps').value);
			const est = w > 0 && r > 0 ? w * (1 + r / 30) : NaN;
			bind('orm-result').textContent = `Estimated 1RM: ${round(est)} kg`;
		}

		function calcRpe() {
			const orm = Number(bind('rpe-orm').value); const reps = Number(bind('rpe-reps').value); const rpe = Number(bind('rpe-value').value);
			const pct = (coeff[reps] ?? 0.68) * (rpeAdj[rpe] ?? 1);
			const load = orm > 0 && pct > 0 ? orm * pct : NaN;
			bind('rpe-result').textContent = `Suggested load: ${round(load)} kg (${(pct*100).toFixed(1)}%)`;
		}

		function calcDots() {
			const male = [-307.75076,24.0900756,-0.1918759221,0.0007391293,-0.000001093];
			const female = [-57.96288,13.6175032,-0.1126655495,0.0005158568,-0.0000010706];
			const sex = bind('dots-sex').value; const bw = Number(bind('dots-bw').value); const total = Number(bind('dots-total').value);
			const c = sex === 'male' ? male : female;
			const denom = c[0] + c[1]*bw + c[2]*bw**2 + c[3]*bw**3 + c[4]*bw**4;
			const score = bw > 0 && total > 0 && denom > 0 ? (500/denom)*total : NaN;
			bind('dots-result').textContent = `DOTS score: ${round(score)}`;
		}

		function calcTdee() {
			const sex = bind('tdee-sex').value; const age = Number(bind('tdee-age').value); const w = Number(bind('tdee-weight').value); const h = Number(bind('tdee-height').value); const a = Number(bind('tdee-activity').value);
			const bmr = sex === 'male' ? 10*w + 6.25*h - 5*age + 5 : 10*w + 6.25*h - 5*age - 161;
			const tdee = bmr > 0 ? bmr * a : NaN;
			bind('tdee-result').textContent = `Estimated TDEE: ${round(tdee)} kcal/day`;
		}

		document.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', () => {
			calc1rm(); calcRpe(); calcDots(); calcTdee();
		}));
	</script>
</Layout>
